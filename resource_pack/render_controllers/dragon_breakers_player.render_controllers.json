      ],
      "arrays": {
        "textures": {
          "Array.skin": [
            "Texture.dbz_arcosian_0",
            "Texture.dbz_arcosian_0",
            "Texture.dbz_arcosian_0",
            "Texture.dbz_arcosian_0"
          ]
        }
      }
    },
    "controller.render.dbz.hair": {
      "arrays": {
        "geometries": {
          "Array.hair": [
            "Geometry.dbz_hair_0",
            "Geometry.dbz_hair_1",
            "Geometry.dbz_hair_2",
            "Geometry.dbz_hair_3"
          ]
        }
      },
      "geometry": "Array.hair[variable.dbz_hair_style]",
      "materials": [
        {
          "*": "Material.dbz_tint"
        }
      ],
      "textures": [
        "Texture.dbz_hair"
      ],
      "color": {
        "r": "variable.dbz_hair_color == 1 ? 0.38 : variable.dbz_hair_color == 2 ? 1.0 : variable.dbz_hair_color == 3 ? 0.22 : variable.dbz_hair_color == 4 ? 0.96 : 0.08",
        "g": "variable.dbz_hair_color == 1 ? 0.17 : variable.dbz_hair_color == 2 ? 0.72 : variable.dbz_hair_color == 3 ? 0.50 : variable.dbz_hair_color == 4 ? 0.96 : 0.08",
        "b": "variable.dbz_hair_color == 1 ? 0.08 : variable.dbz_hair_color == 2 ? 0.10 : variable.dbz_hair_color == 3 ? 1.0 : variable.dbz_hair_color == 4 ? 0.96 : 0.09"
      }
    },
    "controller.render.dbz.saiyan_tail": {
      "geometry": "Geometry.dbz_saiyan_tail",
