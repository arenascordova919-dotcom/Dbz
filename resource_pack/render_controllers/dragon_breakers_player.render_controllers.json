    "controller.render.dbz.hair": {
      "arrays": {
        "geometries": {
          "Array.hair": [
            "Geometry.dbz_hair_0",
            "Geometry.dbz_hair_1",
            "Geometry.dbz_hair_2",
            "Geometry.dbz_hair_3"
          ]
        }
      },
      "geometry": "Array.hair[q.property('dbz:hair_style')]",
      "materials": [
        {
          "*": "Material.dbz_tint"
        }
      ],
      "textures": [
        "Texture.dbz_hair"
      ],
      "color": {
        "r": "q.property('dbz:hair_color') == 1 ? 0.28 : q.property('dbz:hair_color') == 2 ? 1.0 : q.property('dbz:hair_color') == 3 ? 0.18 : q.property('dbz:hair_color') == 4 ? 0.95 : 0.06",
        "g": "q.property('dbz:hair_color') == 1 ? 0.12 : q.property('dbz:hair_color') == 2 ? 0.68 : q.property('dbz:hair_color') == 3 ? 0.45 : q.property('dbz:hair_color') == 4 ? 0.95 : 0.06",
        "b": "q.property('dbz:hair_color') == 1 ? 0.05 : q.property('dbz:hair_color') == 2 ? 0.08 : q.property('dbz:hair_color') == 3 ? 1.0 : q.property('dbz:hair_color') == 4 ? 0.95 : 0.07"
      }
    },
