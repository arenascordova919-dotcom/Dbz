{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.dbz.body.earthling": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skin[variable.dbz_skin_tone]"
      ],
      "arrays": {
        "textures": {
          "Array.skin": [
            "Texture.dbz_earthling_0",
            "Texture.dbz_earthling_0",
            "Texture.dbz_earthling_0",
            "Texture.dbz_earthling_0"
          ]
        }
      }
    },
    "controller.render.dbz.body.saiyan": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skin[variable.dbz_skin_tone]"
      ],
      "arrays": {
        "textures": {
          "Array.skin": [
            "Texture.dbz_saiyan_0",
            "Texture.dbz_saiyan_0",
            "Texture.dbz_saiyan_0",
            "Texture.dbz_saiyan_0"
          ]
        }
      }
    },
    "controller.render.dbz.body.namekian": {
