{
  "namespace": "server_form",
  "third_party_server_screen@common.base_screen": {
    "$screen_animations": [
      "@server_form.screen_exit_animation_pop_wait"
    ],
    "$background_animations": [
      "@server_form.screen_exit_animation_pop_wait"
    ],
    "$screen_content": "server_form.main_screen_content",
    "force_render_below": true,
    "low_frequency_rendering": true,
    "render_only_when_topmost": false,
    "render_game_behind": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },
  "screen_exit_animation_pop_wait": {
    "anim_type": "offset",
    "easing": "linear",
    "duration": 0.1,
    "from": [
      0,
      0
    ],
    "to": [
      0,
      0
    ],
    "play_event": "screen.exit_pop",
    "end_event": "screen.exit_end"
  },
  "main_screen_content": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.select_long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },
  "select_long_form": {
    "type": "panel",
    "controls": [
      {
        "default@server_form.long_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text = 'dbz_race_select') or (#title_text = 'dbz_appearance')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "race@dbz_race_form.race_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'dbz_race_select')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "appearance@dbz_appearance_form.appearance_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'dbz_appearance')",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "long_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": [
      "100% - 12px",
      12
    ],
    "$title_max_size": [
      "100% - 12px",
      12
    ],
    "$title_offset": [
      0,
      5
    ],
    "$custom_background": "dragon_breakers.form_background",
    "size": [
      258,
      220
    ],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.long_form_panel",
    "layer": 2
  },
  "long_form_dynamic_buttons_panel": {
    "type": "stack_panel",
    "size": [
      "100% - 6px",
      "100%c"
    ],
    "offset": [
      3,
      0
    ],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "dynamic_button": {
    "type": "stack_panel",
    "size": [
      "100%",
      27
    ],
    "orientation": "horizontal",
    "controls": [
      {
        "panel_name": {
          "type": "panel",
          "size": [
            30,
            "100%c"
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "image",
              "resolve_sibling_scope": true,
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "image": {
                "type": "image",
                "layer": 2,
                "size": [
                  24,
                  24
                ],
                "offset": [
                  2,
                  1
                ],
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "form_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            "fill",
            25
          ],
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [
            "100%",
            20
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ],
          "$default_button_texture": "textures/ui/dragon_breakers/db_button",
          "$hover_button_texture": "textures/ui/dragon_breakers/db_button_hover",
          "$pressed_button_texture": "textures/ui/dragon_breakers/db_button_pressed",
          "$default_text_color": [
            1,
            0.82,
            0.2
          ],
          "$hover_text_color": [
            1,
            0.96,
            0.78
          ],
          "$pressed_text_color": [
            1,
            0.66,
            0.08
          ],
          "$button_font_size": "small"
        }
      }
    ]
  }
}
