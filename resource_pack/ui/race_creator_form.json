          "anchor_to": "top_middle",
          "offset": [
            0,
            8
          ],
          "shadow": true
        }
      },
      {
        "description": {
          "type": "label",
          "size": [
            "52%",
            "55%"
          ],
          "offset": [
            -14,
            28
          ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "text": "#form_text",
          "text_alignment": "left",
          "color": [
            1,
            1,
            1
          ],
          "shadow": true
        }
      },
      {
        "previous": {
          "type": "stack_panel",
          "collection_name": "form_buttons",
          "anchor_from": "bottom_left",
