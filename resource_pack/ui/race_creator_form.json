            0,
            -10
          ],
          "size": [
            125,
            26
          ],
          "controls": [
            {
              "button@custom_server_form.accept_button": {
                "collection_index": 1
              }
            }
          ]
        }
      },
      {
        "next": {
          "type": "stack_panel",
          "collection_name": "form_buttons",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -18,
            -10
          ],
          "size": [
            32,
            26
          ],
          "controls": [
            {
              "button@custom_server_form.arrow_button": {
                "collection_index": 2
              }
            }
          ]
        }
