{
  "namespace": "dbz_race_form",
  "race_form@server_form.long_form": {
    "size": [
      310,
      190
    ],
    "$child_control": "dbz_race_form.race_panel",
    "$custom_background": "custom_server_form.background",
    "$title_size": [
      0,
      0
    ],
    "$title_max_size": [
      0,
      0
    ]
  },
  "race_panel": {
    "type": "panel",
    "layer": 2,
    "controls": [
      {
        "title": {
          "type": "label",
          "text": "§6§lDRAGON BREAKERS  •  RACE",
